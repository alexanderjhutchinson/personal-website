---
import "@fontsource-variable/fraunces/soft.css";
import "@fontsource-variable/instrument-sans/index.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Link previews (LinkedIn, iMessage, Slack) need full addresses, so these use the `site` in astro.config.
// The build sees /about as /about/; the site serves it without the slash (see wrangler.jsonc).
const url = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site);
const image = new URL("/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0b08" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <!-- The living room from the couch, rendered at the 1.91:1 shape link previews use. -->
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="A 1970s living room at night, lamps on, with a projector and a movie screen" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Decide before first paint whether to show the 3D room or the program on its own ("flat").
      (function () {
        var d = document.documentElement;
        // Old links to the resume now go to the program.
        if (location.pathname === "/" && location.hash === "#resume") return location.replace("/program");
        var webgl = false;
        try {
          webgl = typeof window.WebGL2RenderingContext !== "undefined";
        } catch (e) {}
        d.dataset.mode = webgl ? "room" : "flat";
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
