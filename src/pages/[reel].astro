---
import Room from "../components/Room.astro";
import { REELS, type ReelId } from "../data";
import { person } from "../data/profile";
import Base from "../layouts/Base.astro";

// A reel's address: the room, with that reel already playing on the screen.

export function getStaticPaths() {
  return REELS.map((reel) => ({ params: { reel: reel.path.slice(1) }, props: { id: reel.id } }));
}

const { id } = Astro.props as { id: ReelId };
const reel = REELS.find((r) => r.id === id)!;
---

<Base title={`${reel.title} · ${person.name}`} description={`Reel ${reel.number} of the feature: ${reel.title}.`}>
  <Room reel={id} />
</Base>
