---
import ProgramView from "../components/ProgramView.astro";
import Stage from "../components/Stage.astro";
import { person } from "../data/profile";
import Base from "../layouts/Base.astro";
---

<Base
  title={person.name}
  description={`${person.name}: ${person.program} at the ${person.school}, and ${person.role.toLowerCase()}.`}
>
  <Stage />
  <ProgramView />
</Base>

<script>
  import { boot } from "../scene/boot";
  boot();
</script>
