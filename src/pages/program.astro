---
import ProgramView from "../components/ProgramView.astro";
import Stage from "../components/Stage.astro";
import { person } from "../data/profile";
import Base from "../layouts/Base.astro";

// The same room, opened with the program already picked up: the link to send
// someone who wants the resume.
---

<Base
  title={`The program · ${person.name}`}
  description={`${person.name}: experience, projects, education, skills, and contact.`}
>
  <Stage open="program" />
  <ProgramView />
</Base>

<script>
  import { boot } from "../scene/boot";
  boot();
</script>
