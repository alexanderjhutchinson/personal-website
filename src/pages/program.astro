---
import Room from "../components/Room.astro";
import { person } from "../data/profile";
import Base from "../layouts/Base.astro";

// The room, opened with the program already picked up: the link to send
// someone who wants the resume.
---

<Base
  title={`The program · ${person.name}`}
  description={`${person.name}: experience, projects, education, skills, and contact.`}
>
  <Room open="program" />
</Base>
