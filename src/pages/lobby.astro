---
import "@fontsource/pixelify-sans/500.css";
import Base from "../layouts/Base.astro";
---

<Base title="Lobby · Alexander Hutchinson" description="The first reel of the feature: a pixel lobby to mess around in.">
  <main class="lobby">
    <div class="frame" id="frame">
      <canvas id="lobby-canvas" aria-label="A pixel-art scene at sunset: a small wooden house, a target dummy, trees, and a cave underground. Your character can walk, mine blocks, and swing a sword."></canvas>
      <div class="hud">
        <ol class="hotbar" id="hotbar" aria-label="Hotbar"></ol>
        <p class="item-label" id="item-label" aria-live="polite"></p>
      </div>
      <div class="tooltip" id="tooltip" role="tooltip" hidden></div>
    </div>

    <div class="below">
      <p class="help">
        <span><kbd>A</kbd><kbd>D</kbd> move</span>
        <span><kbd>Space</kbd> jump</span>
        <span><kbd>S</kbd> drop down</span>
        <span>Click to use</span>
        <span><kbd>1</kbd>–<kbd>0</kbd> or scroll to switch items</span>
      </p>
      <div class="links">
        <button id="lobby-sound" class="reel-button" type="button" aria-pressed="false"><span data-label>Sound off</span></button>
        <button id="tune-toggle" class="reel-button" type="button" hidden>Tune the feel</button>
        <a class="back" href="/">Back to the room</a>
      </div>
    </div>

    <aside class="tuning" id="tuning" aria-label="Tuning" hidden></aside>
  </main>
</Base>

<script>
  import { startLobby } from "../lobby/game";
  startLobby();
</script>

<style>
  .lobby {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-block: 24px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    background: #0b0806;
  }

  .frame {
    --px: 3px;
    position: relative;
    max-width: 100%;
    box-shadow:
      0 0 0 calc(var(--px) * 2) #000,
      0 0 60px rgba(224, 163, 58, 0.12);
  }

  canvas {
    display: block;
    image-rendering: pixelated;
    cursor: crosshair;
    touch-action: none;
  }

  .hud {
    position: absolute;
    top: calc(var(--px) * 4);
    left: calc(var(--px) * 4);
    pointer-events: none;
  }

  .hotbar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: calc(var(--px) * 1);
    pointer-events: auto;
  }

  .hotbar :global(.slot) {
    position: relative;
    width: calc(var(--px) * 20);
    height: calc(var(--px) * 20);
    padding: 0;
    display: grid;
    place-items: center;
    background: rgba(28, 24, 48, 0.72);
    border: var(--px) solid rgba(120, 110, 170, 0.75);
    border-radius: calc(var(--px) * 2);
    cursor: pointer;
  }

  .hotbar :global(.slot.selected) {
    background: rgba(70, 58, 30, 0.82);
    border-color: #f2c14e;
  }

  .hotbar :global(.slot img) {
    width: calc(var(--px) * 16);
    height: calc(var(--px) * 16);
    image-rendering: pixelated;
  }

  .hotbar :global(.slot .key),
  .hotbar :global(.slot .count) {
    position: absolute;
    font-family: "Pixelify Sans", var(--font-mono);
    font-size: max(10px, calc(var(--px) * 5));
    line-height: 1;
    color: #f4eedf;
    text-shadow: 1px 1px 0 #000;
  }

  .hotbar :global(.slot .key) {
    top: calc(var(--px) * 1);
    left: calc(var(--px) * 2);
    opacity: 0.7;
  }

  .hotbar :global(.slot .count) {
    bottom: calc(var(--px) * 1);
    right: calc(var(--px) * 2);
  }

  .item-label {
    margin: calc(var(--px) * 2) 0 0;
    font-family: "Pixelify Sans", var(--font-mono);
    font-size: max(11px, calc(var(--px) * 6));
    color: #f4eedf;
    text-shadow: 1px 1px 0 #000;
  }

  .tooltip {
    position: absolute;
    z-index: 2;
    min-width: 9rem;
    padding: 0.5rem 0.7rem;
    background: rgba(20, 16, 36, 0.92);
    border: 1px solid rgba(120, 110, 170, 0.8);
    border-radius: 4px;
    font-family: "Pixelify Sans", var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.3;
    color: #e8e2f2;
    pointer-events: none;
  }

  .tooltip[hidden] {
    display: none;
  }

  .tooltip :global(p) {
    margin: 0;
  }

  .tooltip :global(.tip-name) {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .below {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    width: min(100%, 1152px);
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
  }

  kbd {
    display: inline-block;
    min-width: 1.4em;
    margin-right: 0.25em;
    padding: 0 0.3em;
    border: 1px solid var(--ink-faint);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .tuning {
    position: fixed;
    top: 16px;
    right: max(16px, env(safe-area-inset-right, 0px));
    z-index: 20;
    width: min(20rem, calc(100% - 32px));
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding: 1rem;
    background: rgba(15, 11, 8, 0.94);
    border: 1px solid var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .tuning[hidden] {
    display: none;
  }

  .tuning :global(h2) {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.2rem;
  }

  .tuning :global(.hint) {
    margin: 0 0 0.8rem;
    color: var(--ink-faint);
  }

  .tuning :global(.tune-row) {
    display: grid;
    grid-template-columns: 1fr 3.5rem;
    gap: 0.1rem 0.5rem;
    margin-bottom: 0.55rem;
  }

  .tuning :global(.tune-row span) {
    grid-column: 1 / -1;
    color: var(--ink-dim);
  }

  .tuning :global(.tune-row input) {
    width: 100%;
    accent-color: var(--amber);
  }

  .tuning :global(output) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .tuning :global(.tune-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .tuning :global(.tune-actions button) {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ink-faint);
    border-radius: 2px;
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .tuning :global(.tune-actions button:hover) {
    border-color: var(--amber);
    color: var(--amber);
  }
</style>
