---
import Program from "./Program.astro";

// The program's high-def view over the room. Without the 3D room (no WebGL or
// no JavaScript) it's the page itself.
---

<div class="program-view" id="program-view" tabindex="-1" role="region" aria-label="The program">
  <div class="view-bar">
    <button class="reel-button" type="button" data-hold>Back to the paper <kbd>R</kbd></button>
    <button class="reel-button" type="button" data-put-down>Put it down <kbd>Esc</kbd></button>
  </div>
  <Program />
</div>

<style>
  .program-view {
    padding: clamp(1.5rem, 5vh, 3rem) max(16px, env(safe-area-inset-right, 0px)) 4rem max(16px, env(safe-area-inset-left, 0px));
    outline: none;
  }

  /* With the room running, it only shows while reading. */
  :global(html[data-mode]:not([data-mode="flat"]):not([data-reading])) .program-view {
    display: none;
  }

  :global(html[data-reading]) .program-view {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: 0;
    background: rgba(5, 3, 2, 0.8);
    backdrop-filter: blur(3px);
    animation: view-in 0.3s ease both;
  }

  /* The pages rise into view as it opens, and settle back down as it closes. */
  :global(html[data-reading]) .program-view :global(.program) {
    animation: sheet-in 0.3s ease both;
  }

  :global(html[data-reading="closing"]) .program-view {
    pointer-events: none;
    animation: view-out 0.28s ease both;
  }

  :global(html[data-reading="closing"]) .program-view :global(.program) {
    animation: sheet-out 0.28s ease both;
  }

  @keyframes view-in {
    from {
      opacity: 0;
    }
  }

  @keyframes view-out {
    to {
      opacity: 0;
    }
  }

  @keyframes sheet-in {
    from {
      transform: translateY(18px) scale(0.985);
    }
  }

  @keyframes sheet-out {
    to {
      transform: translateY(18px) scale(0.985);
    }
  }

  .view-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: none;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 -16px 1.25rem;
    padding: max(14px, env(safe-area-inset-top, 0px)) 16px 14px;
    background: linear-gradient(rgba(5, 3, 2, 0.95) 70%, rgba(5, 3, 2, 0));
  }

  :global(html[data-reading]) .view-bar {
    display: flex;
  }

  .view-bar .reel-button {
    padding: 0.5em 0.85em;
    font-size: 0.7rem;
  }

  kbd {
    display: inline-block;
    min-width: 1.5em;
    margin-left: 0.3em;
    padding: 0.05em 0.35em;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.8em;
    line-height: 1.3;
    text-align: center;
  }

  @media (hover: none) {
    kbd {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-reading]) .program-view,
    :global(html[data-reading]) .program-view :global(.program) {
      animation: none;
    }
  }
</style>
