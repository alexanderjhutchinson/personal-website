---
import { about, links, person, roles } from "../data/resume";
---

<main id="resume" class="resume" tabindex="-1">
  <header class="title-card">
    <span class="corner tl" aria-hidden="true"></span>
    <span class="corner tr" aria-hidden="true"></span>
    <span class="corner bl" aria-hidden="true"></span>
    <span class="corner br" aria-hidden="true"></span>
    <p class="label">Reel one</p>
    <h1>{person.name}</h1>
    <p class="divider" aria-hidden="true"><span></span></p>
    <p class="standfirst">
      {person.program}, {person.school}
      <br />
      {person.role}
    </p>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <span class="label">{link.label}</span>
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
              {link.display}
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <section aria-labelledby="experience-title">
    <h2 class="intertitle" id="experience-title">Experience</h2>
    <ol class="roles">
      {
        roles.map((role) => (
          <li class="role">
            <p class="dates">
              <time>{role.start}</time>
              {role.end && (
                <>
                  <span aria-hidden="true"> – </span>
                  <span class="visually-hidden"> to </span>
                  <time>{role.end}</time>
                </>
              )}
            </p>
            <div class="role-body">
              <h3>{role.title}</h3>
              <p class="company">{role.company}</p>
              <ul>
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="about-title">
    <h2 class="intertitle" id="about-title">About</h2>
    <div class="about">
      {about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <footer class="reel-end">
    <p class="next">Projects, hobbies, and photos are on the next reel.</p>
    <button class="reel-button" type="button" data-end-film>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <circle cx="12" cy="12" r="1.6" fill="currentColor"></circle>
        <circle cx="12" cy="7" r="2"></circle>
        <circle cx="16.8" cy="13.6" r="2"></circle>
        <circle cx="7.2" cy="13.6" r="2"></circle>
      </svg>
      End the film
    </button>
  </footer>
</main>

<button class="reel-button end-fixed" type="button" data-end-film>End the film</button>

<canvas id="grain" class="grain" aria-hidden="true"></canvas>

<style>
  .resume {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
    padding-block: clamp(3rem, 8vh, 6rem) 4rem;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    display: grid;
    gap: clamp(3rem, 7vh, 5rem);
    outline: none;
  }

  :global(html[data-mode="room"]) .resume,
  :global(html[data-mode="playing"]) .resume,
  :global(html[data-mode="ending"]) .resume,
  :global(html[data-mode="room"]) .end-fixed,
  :global(html[data-mode="playing"]) .end-fixed,
  :global(html[data-mode="ending"]) .end-fixed,
  :global(html[data-mode="room"]) .grain,
  :global(html[data-mode="playing"]) .grain,
  :global(html[data-mode="ending"]) .grain {
    visibility: hidden;
  }

  :global(html[data-mode="entering"]) .resume {
    animation: resume-in 0.7s ease both;
  }

  @keyframes resume-in {
    from {
      opacity: 0;
      transform: scale(1.015);
    }
  }

  /* The header is a silent-film title card. */
  .title-card {
    position: relative;
    padding: clamp(2.5rem, 7vw, 4rem) clamp(1.25rem, 6vw, 4rem);
    border: 2px solid var(--ink);
    outline: 1px solid var(--ink-dim);
    outline-offset: -11px;
    text-align: center;
  }

  .corner {
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--amber);
    transform: rotate(45deg);
  }

  .tl {
    top: -7px;
    left: -7px;
  }
  .tr {
    top: -7px;
    right: -7px;
  }
  .bl {
    bottom: -7px;
    left: -7px;
  }
  .br {
    bottom: -7px;
    right: -7px;
  }

  h1 {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    width: min(14rem, 70%);
    margin: 1.1rem auto;
  }

  .divider::before,
  .divider::after {
    content: "";
    height: 1px;
    background: var(--amber);
  }

  .divider span {
    width: 9px;
    height: 9px;
    background: var(--amber);
    transform: rotate(45deg);
  }

  .standfirst {
    margin: 0 0 2rem;
    color: var(--ink-dim);
    font-size: var(--step-1);
    line-height: 1.45;
    text-wrap: balance;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2rem;
  }

  .links li {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .links .label {
    color: var(--ink-faint);
    font-size: 0.72rem;
  }

  .links a {
    overflow-wrap: anywhere;
  }

  /* Section headings as intertitles: centered, between two rules with a diamond. */
  .intertitle {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    margin: 0 0 2.25rem;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.1;
    text-align: center;
  }

  .intertitle::before,
  .intertitle::after {
    content: "";
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--rule) 30%, var(--ink-faint));
  }

  .intertitle::after {
    background: linear-gradient(270deg, transparent, var(--rule) 30%, var(--ink-faint));
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .role {
    display: grid;
    grid-template-columns: 10.75rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  .dates {
    margin: 0.2rem 0 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }

  .role-body {
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .company {
    margin: 0.15rem 0 0.8rem;
    color: var(--ink-dim);
  }

  .role ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.55rem;
    color: var(--ink);
  }

  .role li::marker {
    color: var(--ink-faint);
  }

  .about {
    display: grid;
    gap: 1rem;
    max-width: 38rem;
    margin: 0 auto;
    font-size: var(--step-0);
    color: var(--ink);
  }

  .about p {
    margin: 0;
  }

  .reel-end {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    text-align: center;
  }

  .next {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .end-fixed {
    position: fixed;
    top: max(16px, env(safe-area-inset-top, 0px));
    right: max(16px, env(safe-area-inset-right, 0px));
    z-index: 5;
    padding: 0.5em 0.9em;
    font-size: 0.72rem;
  }

  :global(html[data-scene="unavailable"]) [data-end-film],
  :global(html[data-scene="unavailable"]) .end-fixed {
    display: none;
  }

  .grain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
    image-rendering: pixelated;
    mix-blend-mode: overlay;
    opacity: 0.16;
  }

  @media (max-width: 40rem) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
    .end-fixed {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grain {
      display: none;
    }
  }
</style>
