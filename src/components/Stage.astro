---
interface Props {
  /** Open with the program already picked up. */
  open?: "program";
}
const { open } = Astro.props;
---

<div class="stage" id="stage" data-open={open}>
  <canvas
    id="scene"
    role="img"
    aria-label="A 1970s living room at night. A home movie projector sits on the coffee table, pointed at a pull-down screen, with a folded program standing beside it."
  ></canvas>

  <p class="loading" aria-live="polite">Threading the film…</p>

  <div class="top-bar">
    <a id="read-program" class="skip" href="/program">Read the program</a>
    <button id="sound-toggle" class="reel-button sound" type="button" aria-pressed="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" stroke-linejoin="round"></path>
        <g class="waves"><path d="M15.5 9a4 4 0 0 1 0 6"></path><path d="M18 6.5a7.5 7.5 0 0 1 0 11"></path></g>
        <g class="mute"><path d="M16 9.5l5 5M21 9.5l-5 5"></path></g>
      </svg>
      <span data-label>Sound off</span>
    </button>
  </div>

  <!-- Points at the program on the table, the way a game points at something to pick up. -->
  <div class="pickup" id="pickup" hidden aria-hidden="true">
    <span class="pickup-label">
      <span class="fine"><kbd>E</kbd> Pick up the program</span><span class="coarse">Tap to pick up the program</span>
    </span>
  </div>

  <!-- While the program is held up. -->
  <div class="paper-bar" role="group" aria-label="The program">
    <button class="reel-button" type="button" data-turn="-1" aria-label="Previous page"><span aria-hidden="true">◀</span></button>
    <span class="view-name" data-view-name aria-live="polite">Cover</span>
    <button class="reel-button" type="button" data-turn="1" aria-label="Next page"><span aria-hidden="true">▶</span></button>
    <button class="reel-button" type="button" data-put-down>Put it down <kbd>Esc</kbd></button>
  </div>

  <p class="skip-hint">
    <span class="fine">Click or press any key to skip</span><span class="coarse">Tap to skip</span>
  </p>
</div>

<style>
  .stage {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10;
    background: #050302;
  }

  /* The room is the whole site: it's up in every state except the page without it. */
  :global(html[data-mode]:not([data-mode="flat"])) .stage {
    display: block;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }

  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }

  :global(html[data-loading]) .loading {
    opacity: 1;
  }

  /* A reel's address shows the reel straight away; the room fades in around it without a loading line. */
  :global(html[data-mode="reel"]) .loading {
    display: none;
  }

  .top-bar {
    position: absolute;
    top: max(16px, env(safe-area-inset-top, 0px));
    left: max(16px, env(safe-area-inset-left, 0px));
    right: max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .skip {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }

  .sound .waves {
    display: none;
  }

  .sound[aria-pressed="true"] .waves {
    display: inline;
  }

  .sound[aria-pressed="true"] .mute {
    display: none;
  }

  .skip-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    text-align: center;
  }

  .coarse {
    display: none;
  }

  @media (hover: none) {
    .fine {
      display: none;
    }
    .coarse {
      display: inline;
    }
  }

  :global(html[data-loading]) .top-bar {
    opacity: 0;
    pointer-events: none;
  }

  .skip-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(4vh, calc(env(safe-area-inset-bottom, 0px) + 16px));
    opacity: 0;
    pointer-events: none;
  }

  :global(html[data-mode="playing"]) .skip-hint {
    animation: hint-in 0.6s ease 0.8s both;
  }

  @keyframes hint-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.8;
    }
  }

  :global(html[data-mode="playing"]) .top-bar .skip,
  :global(html[data-mode="ending"]) .top-bar .skip,
  :global(html[data-mode="program"]) .top-bar .skip {
    opacity: 0;
    pointer-events: none;
  }

  /* While a reel plays, its own sound button and × take over. */
  :global(html[data-mode="entering"]) .top-bar,
  :global(html[data-mode="reel"]) .top-bar {
    opacity: 0;
    pointer-events: none;
  }

  kbd {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.05em 0.35em;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.8em;
    line-height: 1.3;
    text-align: center;
  }

  /* The pick-up prompt sits above the program on the table; the page places it every frame. */
  .pickup {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2;
    pointer-events: none;
  }

  .pickup[hidden] {
    display: none;
  }

  .pickup > * {
    position: absolute;
    left: 0;
    transform: translateX(-50%);
  }

  .pickup-label {
    bottom: 4px;
    padding: 0.4rem 0.75rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink);
    background: rgba(15, 11, 8, 0.82);
    border: 1px solid var(--amber);
    border-radius: 3px;
    animation: prompt-in 0.45s ease both;
  }

  .pickup-label kbd {
    margin-right: 0.35em;
    color: var(--amber);
  }

  @keyframes prompt-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  .paper-bar {
    position: absolute;
    left: 50%;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 12px));
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: calc(100% - 32px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  :global(html[data-mode="program"]) .paper-bar {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0.35s;
  }

  .paper-bar .reel-button {
    padding: 0.5em 0.8em;
    font-size: 0.7rem;
    background: rgba(15, 11, 8, 0.82);
  }

  .paper-bar .reel-button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .view-name {
    min-width: 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .pickup-label {
      animation: none;
    }
  }
</style>
