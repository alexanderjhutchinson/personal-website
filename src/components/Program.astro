---
import { cover, pages } from "../data/program";

// The program's high-def view: the same four pages as the paper on the coffee
// table, printed in HTML so the text is crisp, selectable, and linkable.
const [first, ...rest] = cover.name.split(" ");
---

<div class="program">
  <article class="page cover" data-page="0" aria-label="Cover">
    <p class="kicker"><span aria-hidden="true">◆</span> {cover.kicker} <span aria-hidden="true">◆</span></p>
    <h1>{first}<br />{rest.join(" ")}</h1>
    <p class="divider" aria-hidden="true"><span></span></p>
    <p class="standfirst">
      {cover.standfirst.map((line) => <span>{line}</span>)}
    </p>
    <h2 class="label">{cover.featureLabel}</h2>
    <ol class="running-order">
      {
        cover.reels.map((reel) => (
          <li>
            <a href={reel.path} data-reel={reel.id}>
              <span class="reel-no">Reel {reel.number}</span>
              <span class="leader" aria-hidden="true" />
              <span class="reel-title">{reel.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="note">{cover.note}</p>
  </article>

  {
    pages.map((sections, i) => (
      <article class="page" data-page={i + 1}>
        {sections.map((section) => (
          <section>
            <h2 class="heading">{section.heading}</h2>
            {section.entries && (
              <ul class="entries">
                {section.entries.map((entry) => (
                  <li>
                    {entry.kicker && <p class="entry-kicker">{entry.kicker}</p>}
                    {entry.title && <h3>{entry.title}</h3>}
                    {entry.lines.map((line) => (
                      <p class="entry-line">{line}</p>
                    ))}
                  </li>
                ))}
              </ul>
            )}
            {section.links && (
              <ul class="links">
                {section.links.map((link) => (
                  <li>
                    <span class="entry-kicker">{link.label}</span>
                    <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                      {link.display}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </article>
    ))
  }
</div>

<style>
  /* Printed on cream stock, in the same faces as the paper on the table. */
  .program {
    --paper: #efe4c8;
    --paper-edge: #e2d4b2;
    --ink: #2b1a10;
    --ink-dim: #6b5240;
    --ink-faint: #9c8668;
    --accent: #a8481f;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: min(100%, 40rem);
    margin: 0 auto;
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .program {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: min(100%, 64rem);
    }
  }

  .page {
    position: relative;
    padding: clamp(1.75rem, 5vw, 2.75rem) clamp(1.5rem, 5vw, 2.75rem);
    background:
      radial-gradient(ellipse at center, transparent 60%, rgba(120, 90, 50, 0.12)),
      var(--paper);
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 1px var(--paper-edge),
      0 18px 40px rgba(0, 0, 0, 0.45);
    scroll-margin-top: 5rem;
  }

  /* A double rule just inside the edge, like the printed paper. */
  .page::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1.5px solid var(--ink);
    outline: 1px solid var(--ink-faint);
    outline-offset: -6px;
    pointer-events: none;
  }

  .cover {
    text-align: center;
  }

  .kicker,
  .label,
  .entry-kicker,
  .reel-no {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .kicker {
    margin: 0.5rem 0 1rem;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 600;
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.4rem);
    line-height: 1;
  }

  .divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    width: min(12rem, 70%);
    margin: 1.2rem auto;
  }

  .divider::before,
  .divider::after {
    content: "";
    height: 1px;
    background: var(--ink);
  }

  .divider span {
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .standfirst {
    display: grid;
    margin: 0 0 2rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ink-dim);
  }

  .label {
    margin: 0 0 0.75rem;
    font-weight: 500;
    color: var(--accent);
  }

  .running-order {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 22rem;
    display: grid;
    gap: 0.35rem;
  }

  .running-order a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.3rem 0.2rem;
    color: var(--ink);
    text-decoration: none;
  }

  .running-order a:hover,
  .running-order a:focus-visible {
    color: var(--accent);
  }

  .reel-no {
    color: var(--ink-dim);
  }

  .leader {
    border-bottom: 2px dotted var(--ink-faint);
    transform: translateY(-0.3em);
  }

  .reel-title {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-size: 1.45rem;
    font-weight: 500;
  }

  .note {
    margin: 1.5rem 0 0.25rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--ink-dim);
  }

  section + section {
    margin-top: 2rem;
  }

  .heading {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.9rem;
    margin: 0.25rem 0 1.1rem;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 500;
    font-size: 1.7rem;
    line-height: 1.1;
    text-align: center;
  }

  .heading::before,
  .heading::after {
    content: "";
    height: 1px;
    background: var(--ink-faint);
  }

  .entries,
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .entry-kicker {
    display: block;
    margin: 0 0 0.15rem;
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .entry-line {
    margin: 0.1rem 0 0;
    color: var(--ink-dim);
    line-height: 1.45;
  }

  .links a {
    color: var(--ink);
    font-size: 1.05rem;
    text-decoration-color: var(--accent);
    overflow-wrap: anywhere;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
